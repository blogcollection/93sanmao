---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('blog')).filter(p => p.data.category === '使用指南' || p.data.category === '基础知识');
---

<BaseLayout 
  title="客户端使用指南与疑难排查 | 三毛 SANMAO VPN"
  description="包含三毛 VPN 在 Windows、macOS、iOS 及 Android 上的一键配置步骤、节点分流设置及常见连接故障解答。"
>
  <div class="bg-[#F5F5F7] py-16 md:py-24 border-b border-black/10">
    <div class="max-w-[1200px] mx-auto px-6 text-center space-y-4">
      <div class="text-xs font-semibold tracking-widest text-brand uppercase">USER GUIDES</div>
      <h1 class="text-4xl sm:text-6xl font-bold text-sanmao-textPrimary tracking-tight">
        使用指南与教程
      </h1>
      <p class="max-w-[640px] mx-auto text-base sm:text-lg text-sanmao-textSecondary">
        帮助您快速完成客户端配置并了解分流设置规则。
      </p>
    </div>
  </div>

  <div class="max-w-[1100px] mx-auto px-6 py-16 md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {guides.map((guide) => (
        <a href={`/blog/${guide.slug}`} class="p-6 rounded-2xl bg-white border border-black/10 hover:border-brand transition-colors space-y-3">
          <div class="text-xs font-semibold text-brand">{guide.data.category}</div>
          <h2 class="text-xl font-bold text-sanmao-textPrimary">{guide.data.title}</h2>
          <p class="text-xs text-sanmao-textSecondary leading-relaxed">{guide.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
