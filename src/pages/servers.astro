---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobalNetwork from '../components/GlobalNetwork.astro';
import { serverNodesConfig } from '../data/servers';
---

<BaseLayout 
  title="全球网络与节点｜三毛 VPN"
  description="查看三毛 VPN 连接的网络节点与地区列表，选择适合你的线路。"
>
  <div class="bg-[#F5F5F7] py-16 md:py-24 border-b border-black/10">
    <div class="max-w-[1200px] mx-auto px-6 text-center space-y-4">
      <div class="text-xs font-semibold tracking-widest text-brand uppercase">GLOBAL LOCATIONS</div>
      <h1 class="text-4xl sm:text-6xl font-bold text-sanmao-textPrimary tracking-tight">
        全球网络
      </h1>
      <p class="max-w-[640px] mx-auto text-base sm:text-lg text-sanmao-textSecondary">
        连接不同地区的网络节点，根据你的使用场景选择合适线路。
      </p>
    </div>
  </div>

  <GlobalNetwork />

  <div class="max-w-[1100px] mx-auto px-6 py-16 md:py-24">
    <div class="space-y-6">
      <div class="flex items-center justify-between border-b border-black/10 pb-4">
        <h2 class="text-2xl font-bold text-sanmao-textPrimary"> Demo 节点列表</h2>
        <span class="text-xs font-mono text-sanmao-textSecondary">{serverNodesConfig.disclaimerText}</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {serverNodesConfig.nodes.map((node) => (
          <div class="p-5 rounded-xl bg-white border border-black/10 flex items-center justify-between">
            <div class="space-y-0.5">
              <div class="font-semibold text-sanmao-textPrimary flex items-center gap-2">
                <span>{node.city}</span>
                <span class="text-xs text-sanmao-textSecondary">({node.country})</span>
              </div>
              <div class="text-xs text-sanmao-textSecondary">支持常用流媒体与在线游戏连接</div>
            </div>

            <div class="text-right space-y-0.5">
              <div class="text-base font-mono font-bold text-brand">{node.latencyDemo} ms</div>
              <div class="text-[10px] text-emerald-600 font-medium">Normal</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
