---
import BaseLayout from '../layouts/BaseLayout.astro';
import { REGISTER_URL } from '../config/site';
---

<BaseLayout 
  title="页面未找到 (404)｜三毛 VPN"
  description="抱歉，您访问的页面不存在或已被移动。"
>
  <div class="bg-[#F5F5F7] py-24 md:py-36 border-b border-black/10">
    <div class="max-w-[800px] mx-auto px-6 text-center space-y-6">
      <div class="text-xs font-mono text-sanmao-textSecondary uppercase tracking-widest">ERROR 404</div>
      <h1 class="text-5xl sm:text-7xl font-bold text-sanmao-textPrimary tracking-tight">
        404
      </h1>
      <p class="text-lg sm:text-xl text-sanmao-textSecondary leading-relaxed">
        抱歉，您访问的页面不存在、已被移动或已更名。
      </p>

      <div class="pt-6 flex flex-wrap items-center justify-center gap-4">
        <a 
          href="/" 
          class="px-8 py-3.5 rounded-full bg-sanmao-textPrimary text-white text-sm font-semibold hover:bg-brand transition-colors shadow-sm"
        >
          返回首页
        </a>
        <a 
          href={REGISTER_URL || '/download'} 
          class="px-8 py-3.5 rounded-full bg-black/5 hover:bg-black/10 text-sanmao-textPrimary text-sm font-semibold transition-colors"
        >
          下载客户端
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
