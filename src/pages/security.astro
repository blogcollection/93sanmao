---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecurityComponent from '../components/Security.astro';
---

<BaseLayout 
  title="安全说明｜三毛 VPN"
  description="了解三毛 VPN 的安全保护与加密连接说明。"
>
  <div class="bg-[#F5F5F7] py-16 md:py-24 border-b border-black/10">
    <div class="max-w-[900px] mx-auto px-6 text-center space-y-4">
      <div class="text-xs font-semibold tracking-widest text-brand uppercase">SECURITY STATEMENT</div>
      <h1 class="text-4xl sm:text-6xl font-bold text-sanmao-textPrimary tracking-tight">
        安全说明
      </h1>
      <p class="text-base sm:text-lg text-sanmao-textSecondary">
        网络连接保护说明。
      </p>
    </div>
  </div>

  <SecurityComponent />
</BaseLayout>
