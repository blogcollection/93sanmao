---
import { REGISTER_URL } from '../config/site';
---

<section id="hero-section" class="relative w-full bg-[#F5F5F7] min-h-[850px] lg:min-h-[920px] flex flex-col items-center justify-between pt-16 md:pt-24 pb-12 overflow-hidden transition-colors duration-700">
  <!-- Background Pattern -->
  <div class="absolute inset-0 pointer-events-none opacity-40">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(0,0,0,0.03)" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)" />
    </svg>
  </div>

  <!-- Content Header Container -->
  <div class="relative z-10 max-w-[840px] px-6 text-center space-y-6">
    <!-- Top Eyebrow -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-black/[0.04] border border-black/[0.06] text-xs font-semibold tracking-wider text-sanmao-textSecondary uppercase">
      <span class="w-2 h-2 rounded-full bg-brand animate-pulse"></span>
      SANMAO VPN
    </div>

    <!-- H1 Typography (Level 1 + Tagline) -->
    <h1 class="text-[48px] sm:text-[68px] lg:text-[88px] font-semibold text-sanmao-textPrimary leading-[1.02] tracking-tight text-balance">
      三毛 VPN。<br class="hidden sm:block" />
      连接全球，更简单。
    </h1>

    <!-- Subtitle -->
    <p class="max-w-[600px] mx-auto text-[17px] sm:text-[20px] text-sanmao-textSecondary font-normal leading-relaxed text-balance">
      简单易用的全球网络连接服务，<br class="hidden sm:block" />在电脑、手机和常用设备上快速连接。
    </p>

    <!-- CTAs -->
    <div class="flex items-center justify-center gap-4 pt-2">
      {REGISTER_URL ? (
        <a href={REGISTER_URL} class="px-7 py-3.5 rounded-full bg-sanmao-textPrimary hover:bg-brand text-white text-[15px] font-medium transition-all transform hover:scale-[1.02] active:scale-[0.98]">
          立即开始
        </a>
      ) : (
        <a href="/pricing" class="px-7 py-3.5 rounded-full bg-sanmao-textPrimary hover:bg-brand text-white text-[15px] font-medium transition-all transform hover:scale-[1.02] active:scale-[0.98]">
          立即开始
        </a>
      )}
      <a href="/vpn" class="px-6 py-3.5 rounded-full bg-transparent hover:bg-black/[0.04] text-sanmao-textPrimary text-[15px] font-medium transition-colors flex items-center gap-1 group">
        了解三毛
        <span class="inline-block transform group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>
  </div>

  <!-- SANMAO Connection Interface Mockup (Scroll Storytelling Target) -->
  <div class="relative z-10 w-full max-w-[760px] px-4 mt-12 mb-4 sticky top-20">
    <div 
      id="hero-mockup-ui" 
      class="relative mx-auto bg-white rounded-[28px] md:rounded-[36px] p-6 md:p-10 border border-black/[0.08] shadow-lg transition-all duration-300 will-change-transform"
    >
      
      <!-- Top Interface Header -->
      <div class="flex items-center justify-between border-b border-black/[0.06] pb-5 mb-8">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl bg-sanmao-textPrimary text-white flex items-center justify-center font-bold text-sm">
            三
          </div>
          <div>
            <div class="text-[15px] font-semibold text-sanmao-textPrimary">三毛 SANMAO</div>
            <div class="text-xs text-sanmao-textSecondary">界面演示</div>
          </div>
        </div>

        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-brand-light border border-brand/20">
          <span class="w-2 h-2 rounded-full bg-brand animate-network-pulse"></span>
          <span class="text-xs font-medium text-brand-dark">Connected (Demo)</span>
        </div>
      </div>

      <!-- Center Big Connection Controls -->
      <div class="flex flex-col md:flex-row items-center justify-between gap-8 py-4">
        <!-- Left Connection Stats -->
        <div class="space-y-4 text-center md:text-left">
          <div>
            <div class="text-xs text-sanmao-textSecondary uppercase tracking-wider font-medium">当前接入节点 (示例)</div>
            <div class="text-2xl font-semibold text-sanmao-textPrimary flex items-center justify-center md:justify-start gap-2 mt-0.5">
              <span>Singapore</span>
              <span class="text-xs font-normal px-2 py-0.5 rounded bg-black/[0.05] text-sanmao-textSecondary">智能分流</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-6 pt-2">
            <div>
              <div class="text-xs text-sanmao-textSecondary">示例延迟</div>
              <div class="text-xl font-semibold text-brand">28 <span class="text-xs text-sanmao-textSecondary font-normal">ms</span></div>
            </div>
            <div>
              <div class="text-xs text-sanmao-textSecondary">已连接时长</div>
              <div class="text-xl font-semibold text-sanmao-textPrimary">01:42:18</div>
            </div>
          </div>
        </div>

        <!-- Center Large Connection Button -->
        <div class="relative group cursor-default">
          <div class="relative w-32 h-32 md:w-36 md:h-36 rounded-full bg-gradient-to-b from-brand to-brand-hover text-white flex flex-col items-center justify-center shadow-md">
            <svg class="w-10 h-10 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span class="text-xs font-semibold tracking-wider uppercase">已开启连接</span>
          </div>
        </div>
      </div>

      <!-- Interface Bottom Status -->
      <div class="mt-8 pt-4 border-t border-black/[0.04] flex items-center justify-between text-xs text-sanmao-textSecondary">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-brand"></span>
          <span>网络隧道保护已激活</span>
        </div>
        <div class="text-[11px] font-mono px-2 py-0.5 rounded bg-black/5">UI Demonstration</div>
      </div>
    </div>
  </div>
</section>

<script>
  // Lightweight Scroll Storytelling using IntersectionObserver & Scroll Listener
  const mockupUi = document.getElementById('hero-mockup-ui');
  const heroSection = document.getElementById('hero-section');

  if (mockupUi && heroSection) {
    window.addEventListener('scroll', () => {
      const rect = heroSection.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      if (rect.top <= 0 && rect.bottom >= 0) {
        const progress = Math.min(1, Math.max(0, -rect.top / (rect.height - windowHeight / 2)));
        const scale = 1 + progress * 0.08;
        const opacity = 1 - progress * 0.15;
        
        mockupUi.style.transform = `scale(${scale})`;
        mockupUi.style.opacity = `${opacity}`;
      } else if (rect.top > 0) {
        mockupUi.style.transform = 'scale(1)';
        mockupUi.style.opacity = '1';
      }
    }, { passive: true });
  }
</script>
