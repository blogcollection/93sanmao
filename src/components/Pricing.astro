---
import { pricingConfig } from '../data/pricing';
import { REGISTER_URL } from '../config/site';
---

<section id="pricing" class="w-full bg-white py-24 md:py-36 border-b border-black/[0.08]">
  <div class="max-w-[900px] mx-auto px-6">
    
    <!-- Section Header -->
    <div class="text-center space-y-4 mb-16">
      <div class="text-xs font-semibold tracking-widest text-brand uppercase">TRANSPARENT PRICING</div>
      <h2 class="text-4xl sm:text-6xl font-semibold text-sanmao-textPrimary tracking-tight">
        套餐与价格
      </h2>
      <p class="text-base sm:text-lg text-sanmao-textSecondary leading-relaxed">
        简单的价格，没有复杂选择。
      </p>

      <div class="inline-block px-4 py-1.5 rounded-full bg-brand-light border border-brand/20 text-brand-dark text-xs font-medium">
        ✨ {pricingConfig.unconfirmedNote}
      </div>
    </div>

    <!-- Single Large Pricing Stage -->
    <div class="bg-[#F5F5F7] rounded-[32px] p-8 sm:p-12 border border-black/[0.08]">
      
      <!-- Top Segmented Selector -->
      <div class="flex items-center justify-center p-1.5 rounded-full bg-black/5 max-w-[420px] mx-auto mb-10">
        {pricingConfig.plans.map((plan, index) => (
          <button 
            data-plan={index}
            class={`pricing-seg-btn flex-1 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all ${
              index === 2 ? 'bg-white text-sanmao-textPrimary shadow-sm' : 'text-sanmao-textSecondary hover:text-sanmao-textPrimary'
            }`}
          >
            {plan.name}
          </button>
        ))}
      </div>

      <!-- Plan Detail Display (Single Active View) -->
      <div id="pricing-stage-content">
        {pricingConfig.plans.map((plan, index) => (
          <div 
            data-stage={index} 
            class={`pricing-stage-item space-y-8 ${index === 2 ? 'block' : 'hidden'}`}
          >
            <!-- Price Block -->
            <div class="text-center space-y-2">
              <div class="text-xs font-mono text-sanmao-textSecondary uppercase tracking-wider">{plan.billingCycle}</div>
              <div class="flex items-baseline justify-center gap-2">
                <span class="text-5xl sm:text-7xl font-bold tracking-tight text-sanmao-textPrimary">{plan.pricePerMonth}</span>
                <span class="text-base text-sanmao-textSecondary">/ 月</span>
              </div>
              <div class="text-xs font-mono text-sanmao-textSecondary">总价: {plan.totalPrice}</div>
              {plan.discountBadge && (
                <div class="inline-block px-3 py-0.5 rounded-full bg-brand text-white text-[11px] font-semibold mt-1">
                  {plan.discountBadge}
                </div>
              )}
            </div>

            <!-- Divider Separated Specs List -->
            <div class="border-t border-b border-black/10 py-6 divide-y divide-black/10 space-y-3 text-sm">
              <div class="pt-3 flex items-center justify-between text-sanmao-textPrimary">
                <span class="font-medium">设备连接限额</span>
                <span class="text-xs font-mono text-sanmao-textSecondary">{plan.deviceLimit}</span>
              </div>
              <div class="pt-3 flex items-center justify-between text-sanmao-textPrimary">
                <span class="font-medium">加速流量分配</span>
                <span class="text-xs font-mono text-sanmao-textSecondary">{plan.trafficLimit}</span>
              </div>
              <div class="pt-3 flex items-center justify-between text-sanmao-textPrimary">
                <span class="font-medium">退款保障规则</span>
                <span class="text-xs font-mono text-sanmao-textSecondary">{plan.refundPolicy}</span>
              </div>
              <div class="pt-3 flex items-center justify-between text-sanmao-textPrimary">
                <span class="font-medium">技术支持层级</span>
                <span class="text-xs font-mono text-sanmao-textSecondary">{plan.supportLevel}</span>
              </div>
            </div>

            <!-- Action CTA Button -->
            <div class="text-center space-y-3 pt-2">
              {REGISTER_URL ? (
                <a 
                  href={REGISTER_URL} 
                  class="block w-full sm:w-auto px-12 py-4 rounded-full bg-sanmao-textPrimary hover:bg-brand text-white text-sm font-semibold transition-colors shadow-md"
                >
                  立即订阅三毛 ({plan.name})
                </a>
              ) : (
                <a 
                  href="/download" 
                  class="inline-block w-full sm:w-auto px-12 py-4 rounded-full bg-sanmao-textPrimary hover:bg-brand text-white text-sm font-semibold transition-colors shadow-md"
                >
                  开始使用三毛 ({plan.name})
                </a>
              )}
              <div class="text-[11px] text-sanmao-textSecondary">
                {plan.statusMessage}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<script>
  // Segmented selector switching logic
  const segBtns = document.querySelectorAll('.pricing-seg-btn');
  const stageItems = document.querySelectorAll('.pricing-stage-item');

  segBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const index = btn.getAttribute('data-plan');

      segBtns.forEach(b => {
        b.classList.remove('bg-white', 'text-sanmao-textPrimary', 'shadow-sm');
        b.classList.add('text-sanmao-textSecondary');
      });
      btn.classList.remove('text-sanmao-textSecondary');
      btn.classList.add('bg-white', 'text-sanmao-textPrimary', 'shadow-sm');

      stageItems.forEach(item => {
        if (item.getAttribute('data-stage') === index) {
          item.classList.remove('hidden');
          item.classList.add('block');
        } else {
          item.classList.remove('block');
          item.classList.add('hidden');
        }
      });
    });
  });
</script>
