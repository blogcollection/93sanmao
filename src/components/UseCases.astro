---
---

<section id="use-cases" class="w-full">
  
  <!-- Full Width Story 1: Streaming (Light Gray Section) -->
  <div class="w-full bg-[#F5F5F7] py-24 md:py-32 border-b border-black/[0.08]">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Editorial Text -->
        <div class="lg:col-span-5 space-y-6">
          <div class="text-xs font-semibold tracking-widest text-brand uppercase">USE CASE 01 — STREAMING</div>
          <h2 class="text-4xl sm:text-6xl font-semibold text-sanmao-textPrimary tracking-tight leading-tight">
            想看的，<br />
            不用等。
          </h2>
          <p class="text-lg text-sanmao-textSecondary leading-relaxed">
            优化流媒体数据包分发专线，专为 4K / 8K 高清视频流畅播放打造。无论是剧集更新还是体育赛事实况，即开即看。
          </p>
          <div class="pt-2 text-xs font-mono text-sanmao-textSecondary">
            支持 4K Ultra HD 协议加速 • 无限流量
          </div>
        </div>

        <!-- Right Column: Tablet / TV Screen Mockup -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-[28px] p-6 md:p-8 border border-black/[0.08] shadow-[0_20px_50px_rgba(0,0,0,0.05)] space-y-6">
            <div class="flex items-center justify-between text-xs text-sanmao-textSecondary border-b border-black/5 pb-4">
              <span class="font-medium text-sanmao-textPrimary">流媒体专线节点已就绪</span>
              <span>4K Stream Ready</span>
            </div>

            <div class="grid grid-cols-3 gap-3 text-center">
              <div class="p-4 rounded-xl bg-[#F5F5F7] border border-black/5 space-y-1">
                <div class="text-xs text-sanmao-textSecondary">Tokyo</div>
                <div class="text-sm font-semibold text-sanmao-textPrimary">4K 60FPS</div>
                <div class="text-[10px] text-brand">35 ms</div>
              </div>
              <div class="p-4 rounded-xl bg-[#F5F5F7] border border-black/5 space-y-1">
                <div class="text-xs text-sanmao-textSecondary">Singapore</div>
                <div class="text-sm font-semibold text-sanmao-textPrimary">8K HDR</div>
                <div class="text-[10px] text-brand">28 ms</div>
              </div>
              <div class="p-4 rounded-xl bg-[#F5F5F7] border border-black/5 space-y-1">
                <div class="text-xs text-sanmao-textSecondary">Los Angeles</div>
                <div class="text-sm font-semibold text-sanmao-textPrimary">4K HDR</div>
                <div class="text-[10px] text-brand">135 ms</div>
              </div>
            </div>

            <div class="text-[11px] text-sanmao-textSecondary/70 text-right">
              UI demonstration / 流媒体加速示意
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Full Width Story 2: Gaming (Black Section) -->
  <div class="w-full bg-black text-white py-24 md:py-32 border-b border-white/10">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Gaming Visual Mockup -->
        <div class="lg:col-span-7 order-2 lg:order-1">
          <div class="bg-sanmao-darkSecondary rounded-[28px] p-8 border border-white/15 space-y-6">
            <div class="flex items-center justify-between text-xs text-white/50 border-b border-white/10 pb-4">
              <span>UDP 电竞低延迟专线</span>
              <span class="text-brand">FEC 丢包补偿已开启</span>
            </div>

            <div class="grid grid-cols-2 gap-6 py-4">
              <div class="space-y-1">
                <div class="text-xs text-white/50">AVERAGE LATENCY</div>
                <div class="text-4xl sm:text-5xl font-bold font-mono text-brand">28 <span class="text-sm font-normal text-white/70">ms</span></div>
                <div class="text-xs text-white/40">对比直连降低 65%</div>
              </div>
              <div class="space-y-1">
                <div class="text-xs text-white/50">PACKET LOSS</div>
                <div class="text-4xl sm:text-5xl font-bold font-mono text-white">0.1%</div>
                <div class="text-xs text-white/40">全程稳定无卡顿</div>
              </div>
            </div>

            <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs text-white/40">
              <span>适用于竞技类 FPS / MOBA 跨服游玩</span>
              <span class="font-mono">UI demonstration</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Editorial Text -->
        <div class="lg:col-span-5 order-1 lg:order-2 space-y-6">
          <div class="text-xs font-semibold tracking-widest text-brand uppercase">USE CASE 02 — GAMING</div>
          <h2 class="text-4xl sm:text-6xl font-semibold text-white tracking-tight leading-tight">
            低一点延迟，<br />
            多一点胜算。
          </h2>
          <p class="text-lg text-white/70 leading-relaxed">
            专为竞技游戏优化的 UDP 封装协议与低丢包线路，在关键对局中大幅压低 RTT 抖动。
          </p>
        </div>

      </div>
    </div>
  </div>

</section>
