---
---

<section class="relative w-full bg-black text-white min-h-[640px] md:min-h-[720px] flex flex-col items-center justify-center py-20 overflow-hidden">
  
  <!-- Subtle Background Network Ray Animation -->
  <div class="absolute inset-0 opacity-20 pointer-events-none">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="cta-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#00A88F" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#000000" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="100%" height="100%" fill="url(#cta-glow)" />
      <!-- Animated Network Beams -->
      <path d="M 0 360 Q 400 100 1200 360" stroke="#00A88F" stroke-width="1" stroke-dasharray="8 8" class="animate-pulse-slow" />
      <path d="M 0 420 Q 600 600 1200 200" stroke="#00A88F" stroke-width="1" stroke-dasharray="4 6" opacity="0.6" />
    </svg>
  </div>

  <div class="relative z-10 max-w-[800px] mx-auto px-6 text-center space-y-8">
    <!-- Brand Name Top -->
    <div class="text-xs font-mono tracking-widest text-brand uppercase">
      SANMAO NETWORK
    </div>

    <!-- H2 Typography -->
    <h2 class="text-4xl sm:text-6xl lg:text-7xl font-semibold text-white tracking-tight leading-tight">
      世界很大。<br />
      连接很简单。
    </h2>

    <p class="max-w-[560px] mx-auto text-base sm:text-lg text-white/70 leading-relaxed">
      三毛为你的每一台设备提供高速、稳定、加密且极简的全球网络代理隧道体验。
    </p>

    <!-- CTAs -->
    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/pricing" class="w-full sm:w-auto px-10 py-4 rounded-full bg-brand hover:bg-brand-hover text-white text-base font-semibold transition-all transform hover:scale-[1.02] active:scale-[0.98] shadow-lg">
        开始使用三毛
      </a>
      <a href="/download" class="w-full sm:w-auto px-8 py-4 rounded-full bg-white/10 hover:bg-white/20 text-white text-base font-medium transition-colors border border-white/10">
        下载全平台客户端
      </a>
    </div>
  </div>

</section>
